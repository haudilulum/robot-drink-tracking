[Unit]
Description=Robot Drink Tracking (PB1 kopi / PB2 teh)
After=multi-user.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__PY__ __DIR__/main.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
